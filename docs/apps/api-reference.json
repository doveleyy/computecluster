{
  "components": {
    "schemas": {
      "DirectoryResponse": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "directory",
            "title": "Kind",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "path": {
            "title": "Path",
            "type": "string"
          },
          "size_bytes": {
            "title": "Size Bytes",
            "type": "null"
          }
        },
        "required": [
          "name",
          "path",
          "kind",
          "size_bytes"
        ],
        "title": "DirectoryResponse",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "FileHandleRequest": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Path",
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "title": "FileHandleRequest",
        "type": "object"
      },
      "FileResponse": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "file",
            "title": "Kind",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "path": {
            "title": "Path",
            "type": "string"
          },
          "size_bytes": {
            "minimum": 0.0,
            "title": "Size Bytes",
            "type": "integer"
          }
        },
        "required": [
          "name",
          "path",
          "kind",
          "size_bytes"
        ],
        "title": "FileResponse",
        "type": "object"
      },
      "FilesResponse": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "discriminator": {
                "mapping": {
                  "directory": "#/components/schemas/DirectoryResponse",
                  "file": "#/components/schemas/FileResponse"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/components/schemas/FileResponse"
                },
                {
                  "$ref": "#/components/schemas/DirectoryResponse"
                }
              ]
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "FilesResponse",
        "type": "object"
      },
      "InputResponse": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Sha256",
            "type": "string"
          },
          "size_bytes": {
            "exclusiveMinimum": 0.0,
            "title": "Size Bytes",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "size_bytes",
          "sha256"
        ],
        "title": "InputResponse",
        "type": "object"
      },
      "ResultResponse": {
        "additionalProperties": false,
        "properties": {
          "download_url": {
            "title": "Download Url",
            "type": "string"
          },
          "index": {
            "minimum": 0.0,
            "title": "Index",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Sha256",
            "type": "string"
          },
          "size_bytes": {
            "minimum": 0.0,
            "title": "Size Bytes",
            "type": "integer"
          }
        },
        "required": [
          "index",
          "name",
          "size_bytes",
          "sha256",
          "download_url"
        ],
        "title": "ResultResponse",
        "type": "object"
      },
      "ResultsResponse": {
        "additionalProperties": false,
        "properties": {
          "outputs": {
            "items": {
              "$ref": "#/components/schemas/ResultResponse"
            },
            "title": "Outputs",
            "type": "array"
          }
        },
        "required": [
          "outputs"
        ],
        "title": "ResultsResponse",
        "type": "object"
      },
      "RunRequest": {
        "additionalProperties": false,
        "properties": {
          "inputs": {
            "maxProperties": 32,
            "patternProperties": {
              "^[A-Za-z][A-Za-z0-9._-]{0,63}$": {
                "format": "uuid",
                "type": "string"
              }
            },
            "title": "Inputs",
            "type": "object"
          },
          "installation_id": {
            "format": "uuid",
            "title": "Installation Id",
            "type": "string"
          }
        },
        "required": [
          "installation_id",
          "inputs"
        ],
        "title": "RunRequest",
        "type": "object"
      },
      "RunResponse": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "installation_id": {
            "format": "uuid",
            "title": "Installation Id",
            "type": "string"
          },
          "status": {
            "enum": [
              "QUEUED",
              "RUNNING",
              "COMPLETED",
              "FAILED",
              "CANCELLED"
            ],
            "title": "Status",
            "type": "string"
          },
          "tasks": {
            "items": {
              "$ref": "#/components/schemas/TaskResponse"
            },
            "title": "Tasks",
            "type": "array"
          }
        },
        "required": [
          "id",
          "installation_id",
          "status",
          "tasks"
        ],
        "title": "RunResponse",
        "type": "object"
      },
      "RunsResponse": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/RunResponse"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "RunsResponse",
        "type": "object"
      },
      "TaskResponse": {
        "additionalProperties": false,
        "properties": {
          "index": {
            "minimum": 0.0,
            "title": "Index",
            "type": "integer"
          },
          "status": {
            "enum": [
              "QUEUED",
              "RUNNING",
              "COMPLETED",
              "FAILED",
              "CANCELLED"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "index",
          "status"
        ],
        "title": "TaskResponse",
        "type": "object"
      },
      "UserResponse": {
        "additionalProperties": false,
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "display_name"
        ],
        "title": "UserResponse",
        "type": "object"
      },
      "WorkloadResponse": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "inputs": {
            "items": {
              "type": "string"
            },
            "title": "Inputs",
            "type": "array"
          },
          "release_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Release Sha256",
            "type": "string"
          },
          "workload_id": {
            "title": "Workload Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "release_sha256",
          "workload_id",
          "inputs"
        ],
        "title": "WorkloadResponse",
        "type": "object"
      },
      "WorkloadsResponse": {
        "additionalProperties": false,
        "properties": {
          "active_release_sha256": {
            "anyOf": [
              {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Release Sha256"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/WorkloadResponse"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "active_release_sha256",
          "items"
        ],
        "title": "WorkloadsResponse",
        "type": "object"
      }
    },
